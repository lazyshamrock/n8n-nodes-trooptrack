{
  "name": "n8n-nodes-trooptrack",
  "version": "0.1.0",
  "description": "n8n community node for the TroopTrack API",
  "license": "MIT",
  "author": "",
  "keywords": [
    "n8n-community-node",
    "n8n",
    "trooptrack",
    "automation"
  ],
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && npm run copy:assets",
    "dev": "tsc -w -p tsconfig.json",
    "prepack": "npm run build",
    "copy:assets": "node ./scripts/copy-assets.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TroopTrackApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TroopTrack/TroopTrack.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}