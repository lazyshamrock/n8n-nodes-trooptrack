{
  "name": "n8n-nodes-trooptrack",
  "version": "1.1.25",
  "description": "n8n community node for the TroopTrack API",
  "license": "MIT",
  "author": "",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes",
    "n8n-community-node",
    "n8n",
    "trooptrack",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazyshamrock/n8n-nodes-trooptrack.git"
  },
  "homepage": "https://github.com/lazyshamrock/n8n-nodes-trooptrack#readme",
  "bugs": {
    "url": "https://github.com/lazyshamrock/n8n-nodes-trooptrack/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rimraf dist && tsc -p tsconfig.json && npm run copy:assets",
    "dev": "tsc -w -p tsconfig.json",
    "prepack": "npm run build",
    "copy:assets": "node ./scripts/copy-assets.mjs",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint nodes credentials --ext .ts",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint nodes credentials --ext .ts --fix"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TroopTrackApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TroopTrack/TroopTrack.node.js"
    ]
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
